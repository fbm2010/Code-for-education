# ── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=https://your-codespace-name-5174.app.github.dev
API_URL=https://your-codespace-name-3000.app.github.dev

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://zerolink:zerolink_dev@localhost:5432/zerolink

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth (generate with: openssl rand -hex 32) ───────────────
SESSION_SECRET=change_me_32_byte_hex_value_here_00
SESSION_TTL_DAYS=30

# ── Object Storage (MinIO) ───────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=zerolink
MINIO_SECRET_KEY=zerolink_secret
MINIO_BUCKET_MEDIA=zerolink-media
MINIO_BUCKET_BUNDLES=zerolink-bundles
MINIO_USE_SSL=false

# ── CDN ──────────────────────────────────────────────────────
CDN_BASE_URL=https://your-codespace-name-9000.app.github.dev/zerolink-media

# ── Optional OAuth ───────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Translation (Lokalise) ───────────────────────────────────
LOKALISE_API_URL=https://api.lokalise.com/api2
LOKALISE_API_TOKEN=
LOKALISE_PROJECT_ID=
LOKALISE_CREATE_MISSING_KEYS=true
LOKALISE_TRANSLATION_RETRIES=3

# ── Monitoring ───────────────────────────────────────────────
SENTRY_DSN=

# ── Sync Encryption (generate with: openssl rand -hex 32) ────
SYNC_ENCRYPTION_KEY=change_me_32_byte_hex_value_here_00

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
