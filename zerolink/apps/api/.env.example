# ── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://zerolink:zerolink_dev@localhost:5432/zerolink

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth (generate with: openssl rand -hex 32) ───────────────
SESSION_SECRET=change_me_32_byte_hex_value_here_00
SESSION_TTL_DAYS=30

# ── Object Storage (MinIO) ───────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=zerolink
MINIO_SECRET_KEY=zerolink_secret
MINIO_BUCKET_MEDIA=zerolink-media
MINIO_BUCKET_BUNDLES=zerolink-bundles
MINIO_USE_SSL=false

# ── CDN ──────────────────────────────────────────────────────
CDN_BASE_URL=http://localhost:9000/zerolink-media

# ── Optional OAuth ───────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Translation (LibreTranslate — self-hosted) ───────────────
LIBRETRANSLATE_URL=http://localhost:5000
LIBRETRANSLATE_API_KEY=

# ── Monitoring ───────────────────────────────────────────────
SENTRY_DSN=

# ── Sync Encryption (generate with: openssl rand -hex 32) ────
SYNC_ENCRYPTION_KEY=change_me_32_byte_hex_value_here_00

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
