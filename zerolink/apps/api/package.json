{
  "name": "@zerolink/api",
  "version": "1.0.0",
  "description": "ZeroLink — Offline-first multilingual learning platform API",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "drizzle-kit migrate:pg",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@zerolink/shared": "*",
    "@types/archiver": "^6.0.2",
    "@types/node": "^20.12.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.15",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.3",
    "@fastify/compress": "^7.0.3",
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/csrf-protection": "^6.4.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^3.1.0",
    "@lucia-auth/adapter-drizzle": "^1.1.0",
    "@node-rs/argon2": "^1.8.3",
    "@sentry/node": "^8.0.0",
    "archiver": "^7.0.1",
    "bullmq": "^5.7.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.30.9",
    "fastify": "^4.26.2",
    "ioredis": "^5.3.2",
    "lucia": "^3.2.2",
    "minio": "^8.0.1",
    "node-cron": "^3.0.3",
    "oslo": "^1.2.1",
    "pg": "^8.21.0",
    "pino": "^8.20.0",
    "pino-pretty": "^11.0.0",
    "postgres": "^3.4.4",
    "sharp": "^0.33.5",
    "zod": "^3.22.5",
    "nodemailer": "^6.9.13",
    "web-push": "^3.6.7",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^1.5.0",
    "drizzle-kit": "^0.20.14",
    "supertest": "^7.0.0",
    "tsx": "^4.8.2",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  }
}
